 import SwiftUI
 import UIKit
 import UniformTypeIdentifiers
+
+
+private struct PunisherVehicleProfile: Identifiable, Hashable {
+    let id: String
+    let brand: String
+    let model: String
+    let years: ClosedRange<Int>
+    let visualAsset: String?
+    let supportsLock: Bool
+    let supportsUnlock: Bool
+    let supportsRemoteStart: Bool
+    let supportsAlarm: Bool
+
+    var displayName: String { "\(brand) \(model)" }
+}
+
+private enum PunisherVehicleCatalog {
+    static let profiles: [PunisherVehicleProfile] = [
+        .init(id: "dodge_journey_2017", brand: "Dodge", model: "Journey", years: 2017...2017, visualAsset: "JourneySEClosed", supportsLock: true, supportsUnlock: true, supportsRemoteStart: true, supportsAlarm: true),
+        .init(id: "toyota_camry_2024", brand: "Toyota", model: "Camry", years: 2024...2024, visualAsset: nil, supportsLock: false, supportsUnlock: false, supportsRemoteStart: false, supportsAlarm: false),
+        .init(id: "toyota_land_cruiser_2024", brand: "Toyota", model: "Land Cruiser", years: 2024...2024, visualAsset: nil, supportsLock: false, supportsUnlock: false, supportsRemoteStart: false, supportsAlarm: false)
+    ]
+
+    static func profile(id: String) -> PunisherVehicleProfile? { profiles.first { $0.id == id } }
+    static var brands: [String] { Array(Set(profiles.map(\.brand))).sorted() }
+    static func models(for brand: String) -> [String] { Array(Set(profiles.filter { $0.brand == brand }.map(\.model))).sorted() }
+    static func years(for brand: String, model: String) -> [Int] {
+        Array(Set(profiles.filter { $0.brand == brand && $0.model == model }.flatMap { Array($0.years) })).sorted(by: >)
+    }
+    static func resolve(brand: String, model: String, year: Int) -> PunisherVehicleProfile? {
+        profiles.first { $0.brand == brand && $0.model == model && $0.years.contains(year) }
+    }
+}
 
