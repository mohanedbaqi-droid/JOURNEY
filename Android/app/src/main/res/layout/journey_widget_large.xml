<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="14dp"
 android:background="@drawable/widget_panel">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp"
   android:layout_height="wrap_content" android:layout_weight="1"
   android:text="JOURNEY" android:textColor="#F3FAFF" android:textStyle="bold"
   android:textSize="18sp"/>
  <TextView android:id="@+id/widget_status" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:text="—"
   android:textColor="#FFB15D" android:textSize="12sp"/>
 </LinearLayout>
 <ImageView android:id="@+id/widget_car" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1"
  android:src="@drawable/journey_layer_body" android:scaleType="fitCenter"
  android:contentDescription="JOURNEY car"/>
 <TextView android:id="@+id/widget_reading" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:gravity="center"
  android:text="—" android:textColor="#D8EDF4" android:textSize="13sp"
  android:paddingBottom="6dp"/>
 <TextView android:id="@+id/widget_details" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:gravity="center"
  android:text="—" android:textColor="#D8EDF4" android:textSize="12sp"
  android:paddingBottom="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
  android:orientation="horizontal">
  <Button android:id="@+id/widget_unlock" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:text="فتح" android:textSize="13sp" android:textColor="#35D9FF"
   android:backgroundTint="#124251"/>
  <Button android:id="@+id/widget_lock" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:text="قفل" android:textSize="13sp" android:textColor="#35D9FF"
   android:backgroundTint="#124251"/>
  <Button android:id="@+id/widget_start" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:text="تشغيل" android:textSize="13sp" android:textColor="#FFC07A"
   android:backgroundTint="#49301E"/>
 </LinearLayout>
</LinearLayout>